# Copia este archivo a .env y ajusta los valores

# --- Base de datos PostgreSQL ---
# Local:
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/fishroute_db
# Con Docker Compose:
# DATABASE_URL=postgresql+asyncpg://fishroute:fishroute@db:5432/fishroute_db
# Railway (usa la variable que ellos proveen):
# DATABASE_URL=postgresql+asyncpg://...railway.app:5432/railway

# --- Redis (opcional — app degrada sin él) ---
REDIS_URL=redis://localhost:6379/0
# Con Docker Compose:
# REDIS_URL=redis://redis:6379/0

# --- JWT ---
# OBLIGATORIA en producción — genera con: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-in-production-min-32-chars

# --- CORS ---
# En producción: solo el dominio de Vercel (sin trailing slash)
# Desarrollo: http://localhost:4200
# Producción: https://fishroute-pro.vercel.app
ALLOWED_ORIGINS=http://localhost:4200
